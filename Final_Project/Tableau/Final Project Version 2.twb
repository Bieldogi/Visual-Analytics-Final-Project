      <aliases enabled='yes' />
      <column caption='Obesidad Hombres' datatype='real' name='[Calculation_740279203102957568]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Gender] = &apos;Male&apos;, [Prevalence], NULL)' />
      </column>
      <column caption='Obesidad Mujeres' datatype='real' name='[Calculation_740279203103100929]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Gender] = &apos;Female&apos;, [Prevalence], NULL)' />
      </column>
      <column caption='Selected Metric' datatype='real' name='[Calculation_740279203142279171]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;  WHEN &quot;Fertility Rate&quot; THEN [FertilityRate]&#13;&#10;  WHEN &quot;Under 5 Mortality&quot; THEN [Under5_Mortality]&#13;&#10;  WHEN &quot;GNI per Capita&quot; THEN [GNI_perCapita_Atlas_USD]&#13;&#10;  WHEN &quot;Health Exp % GDP&quot; THEN [HealthExp_pct_GDP]&#13;&#10;END' />
      </column>
      <column caption='Danger' datatype='string' name='[Calculation_740279203216871428]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [LifeExpectancy] &gt; 65 AND [Prevalence] &lt; 20 THEN &quot;Vida Larga / Delgado&quot;&#13;&#10;ELSEIF [LifeExpectancy] &gt; 65 AND [Prevalence] &gt;= 20 THEN &quot;Vida Larga / Obeso&quot;&#13;&#10;ELSEIF [LifeExpectancy] &lt;= 65 AND [Prevalence] &lt; 20 THEN &quot;Vida Corta / Delgado&quot;&#13;&#10;ELSE &quot;Vida Corta / Obeso&quot;&#13;&#10;END' />
      </column>
      <column caption='Creixement' datatype='integer' name='[Calculation_740279203218182149]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Country Name] : SUM(IIF([Year] = 2010, [LifeExpectancy], 0))} &#13;&#10;- &#13;&#10;{FIXED [Country Name] : SUM(IIF([Year] = 1970, [LifeExpectancy], 0))}' />
      </column>
